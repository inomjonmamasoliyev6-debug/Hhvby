async def handle_withdraw_state(update: Update, context: ContextTypes.DEFAULT_TYPE, user_id, text) -> bool:
    """Foydalanuvchi karta raqami kiritish holatida bo'lsa ishlaydi. True qaytarsa - qayta ishlangan."""
    state = context.user_data.get("state")
    if state != "withdraw_card_number":
        return False

    if text == CANCEL_TEXT:
        context.user_data["state"] = None
        context.user_data.pop("withdraw_card_type", None)
        await api_call(lambda: update.message.reply_text(
            "🚫 Bekor qilindi.", reply_markup=main_keyboard(user_id),
        ), action_desc="wd_number_cancel")
        return True

    digits = "".join(ch for ch in text if ch.isdigit())
    if len(digits) != 16:
        await api_call(lambda: update.message.reply_text(
            "❌ Karta raqami noto'g'ri. 16 ta raqamdan iborat bo'lishi kerak.\n"
            "Masalan: `8600 1234 5678 9012`",
            parse_mode="Markdown",
        ), action_desc="wd_number_invalid")
        return True

    card_type = context.user_data.get("withdraw_card_type", "Boshqa")

    # Balansni yana bir bor (yakuniy) tekshiramiz va to'liq summani yechamiz
    user = await get_user(user_id)
    balance = user[1] if user else 0.0
    if balance < MIN_WITHDRAW:
        context.user_data["state"] = None
        context.user_data.pop("withdraw_card_type", None)
        await api_call(lambda: update.message.reply_text(
            "🚫 Balansingiz yetarli emas. Qayta urinib ko'ring.",
            reply_markup=main_keyboard(user_id),
        ), action_desc="wd_number_low_balance")
        return True

    amount = balance
    card_number = " ".join(digits[i:i + 4] for i in range(0, 16, 4))

    await add_balance(user_id, -amount)  # summani balansdan darhol ushlab qolamiz
    withdrawal_id = await create_withdrawal(user_id, amount, card_type, card_number)

    context.user_data["state"] = None
    context.user_data.pop("withdraw_card_type", None)

    await api_call(lambda: update.message.reply_text(
        "✅ *So'rovingiz qabul qilindi!*\n"
        f"{DIVIDER}\n"
        f"💰 Miqdor: *{amount:,.0f} so'm*\n"
        f"💳 Karta: *{card_type}* `{card_number}`\n\n"
        "⏳ 30 daqiqa ichida pulingiz kartangizga tashlanadi.\n"
        "Agar tashlanmasa, quyidagi tugma orqali adminga murojaat qiling 👇",
        parse_mode="Markdown",
        reply_markup=withdraw_submitted_keyboard(),
    ), action_desc="wd_number_confirm")
    await api_call(lambda: update.message.reply_text(
        "Bo'lim tanlang:", reply_markup=main_keyboard(user_id),
    ), action_desc="wd_number_menu")

    # Adminlarga xabar beramiz
    requester = update.effective_user
    admin_text = (
        "💸 *Yangi pul yechish so'rovi!*\n"
        f"{DIVIDER}\n"
        f"👤 {_fmt_user(requester)}\n"
        f"💰 Summa: *{amount:,.0f} so'm*\n"
        f"💳 Karta: *{card_type}* `{card_number}`\n"
        f"🆔 So'rov raqami: `{withdrawal_id}`"
    )
    for admin_id in ADMINS:
        await api_call(lambda a=admin_id: context.bot.send_message(
            chat_id=a,
            text=admin_text,
            parse_mode="Markdown",
            reply_markup=admin_withdraw_keyboard(withdrawal_id),
        ), action_desc=f"notify_admin:{admin_id}")

    return True


async def withdraw_admin_decision_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        query = update.callback_query
        admin_id = query.from_user.id
        if admin_id not in ADMINS:
            await api_call(lambda: query.answer("⛔ Ruxsat yo'q", show_alert=True), action_desc="wd_decision_denied")
            return

        action, wid_str = query.data.split(":", 1)
        withdrawal_id = int(wid_str)
        row = await get_withdrawal(withdrawal_id)
        if not row:
            await api_call(lambda: query.answer("❌ So'rov topilmadi", show_alert=True), action_desc="wd_decision_missing")
            return

        wid, target_user_id, amount, card_type, card_number, status = row
        if status != "pending":
            await api_call(lambda: query.answer("ℹ️ Bu so'rov allaqachon ko'rib chiqilgan", show_alert=True), action_desc="wd_decision_done")
            return

        await api_call(lambda: query.answer(), action_desc="wd_decision_ack")

        if action == "wdok":
            await set_withdrawal_status(withdrawal_id, "approved")
            await api_call(lambda: query.message.edit_text(
                query.message.text_markdown + f"\n\n✅ *Tasdiqlandi* — {query.from_user.full_name}",
                parse_mode="Markdown",
            ), action_desc="wd_decision_edit_ok")
            await api_call(lambda: context.bot.send_message(
                chat_id=target_user_id,
                text=f"✅ *So'rovingiz tasdiqlandi!*\n{DIVIDER}\n"
                     f"💰 *{amount:,.0f} so'm* taxminan *26 daqiqada* kartangizga tushadi.",
                parse_mode="Markdown",
            ), action_desc="wd_notify_user_ok")
            return

        if action == "wdno":
            context.user_data["state"] = "wd_reject_reason"
            context.user_data["wd_reject_id"] = withdrawal_id
            await api_call(lambda: query.message.edit_text(
                query.message.text_markdown + "\n\n✍️ Rad etish sababini yozib yuboring:",
                parse_mode="Markdown",
            ), action_desc="wd_decision_edit_no")
            await api_call(lambda: query.message.chat.send_message("👇", reply_markup=cancel_keyboard()), action_desc="wd_decision_no_kb")
            return
    except Exception:
        logger.exception("withdraw_admin_decision_callback() ichida kutilmagan xato")


async def handle_withdraw_reject_reason_state(update: Update, context: ContextTypes.DEFAULT_TYPE, user_id, text) -> bool:
    state = context.user_data.get("state")
    if state != "wd_reject_reason":
        return False

    withdrawal_id = context.user_data.get("wd_reject_id")
    context.user_data["state"] = None
    context.user_data.pop("wd_reject_id", None)

    if text == CANCEL_TEXT:
        await api_call(lambda: update.message.reply_text(
            "🚫 Bekor qilindi.", reply_markup=main_keyboard(user_id),
        ), action_desc="wd_reject_cancelled")
        return True

    row = await get_withdrawal(withdrawal_id) if withdrawal_id else None
    if not row or row[5] != "pending":
        await api_call(lambda: update.message.reply_text(
            "ℹ️ Bu so'rov allaqachon ko'rib chiqilgan yoki topilmadi.",
            reply_markup=main_keyboard(user_id),
        ), action_desc="wd_reject_missing")
        return True

    wid, target_user_id, amount, card_type, card_number, status = row
    await set_withdrawal_status(withdrawal_id, "rejected")
    await add_balance(target_user_id, amount)  # summani foydalanuvchiga qaytaramiz

    await api_call(lambda: context.bot.send_message(
        chat_id=target_user_id,
        text=f"❌ *So'rovingiz rad etildi.*\n{DIVIDER}\n"
             f"📝 Sabab: {text}\n\n"
             f"💰 *{amount:,.0f} so'm* balansingizga qaytarildi.",
        parse_mode="Markdown",
    ), action_desc="wd_notify_user_reject")

    await api_call(lambda: update.message.reply_text(
        "✅ Rad etish sababi foydalanuvchiga yuborildi.",
        reply_markup=main_keyboard(user_id),
    ), action_desc="wd_reject_confirm_admin")
    return True


