#  3) TARMOQ XATOLARIGA CHIDAMLI YORDAMCHI (retry + backoff)
# ========================================================

async def api_call(coro_factory, *, retries=NET_RETRIES, base_delay=NET_BASE_DELAY,
                    swallow=True, default=None, action_desc=""):
    """
    Har qanday Telegram API chaqiruvini xavfsiz bajaradi:
      - httpx/telegram tarmoq xatolarida (ConnectTimeout, TimedOut, NetworkError)
        eksponensial kutish bilan qayta urinadi.
      - `coro_factory` — argumentsiz funksiya bo'lishi kerak, chaqirilganda YANGI
        coroutine qaytarishi shart (masalan: lambda: bot.send_message(...)),
        chunki bitta coroutine ikki marta await qilinmaydi.
      - `swallow=True` bo'lsa, barcha urinishlar tugagach xatoni yutib, `default`
        qaytaradi (bot cho'kmasligi uchun). `swallow=False` bo'lsa, oxirgi
        urinishdan keyin xatoni qayta ko'taradi.
    """
    last_exc = None
    for attempt in range(retries):
        try:
            return await coro_factory()
        except (TimedOut, NetworkError) as e:
            last_exc = e
            if attempt < retries - 1:
                delay = base_delay * (2 ** attempt)
                logger.warning(
                    "Tarmoq xatosi%s (urinish %s/%s): %s — %.1fs kutib, qayta urinilmoqda...",
                    f" [{action_desc}]" if action_desc else "", attempt + 1, retries, e, delay,
                )
                await asyncio.sleep(delay)
                continue
            logger.error(
                "Tarmoq xatosi%s: barcha %s urinish muvaffaqiyatsiz tugadi: %s",
                f" [{action_desc}]" if action_desc else "", retries, e,
            )
        except Forbidden:
            # Foydalanuvchi botni bloklagan — qayta urinishning foydasi yo'q
            return default
        except TelegramError as e:
            logger.error("Telegram xatosi%s: %s", f" [{action_desc}]" if action_desc else "", e)
            if not swallow:
                raise
            return default
    if swallow:
        return default
    if last_exc:
        raise last_exc
    return default


