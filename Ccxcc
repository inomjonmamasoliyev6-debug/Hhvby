async def check_one_channel(context, channel_id, user_id):
    result = await api_call(
        lambda: context.bot.get_chat_member(chat_id=channel_id, user_id=user_id),
        action_desc=f"get_chat_member:{channel_id}",
        swallow=True,
        default=None,
    )
    if result is None:
        # Tekshirib bo'lmadi — foydalanuvchini bloklab qo'ymaslik uchun ruxsat beramiz
        return True
    return result.status not in ('left', 'kicked')


async def is_subscribed(user_id, context, use_cache=True):
    # Adminlar obuna talabidan ozod - aks holda o'zlarini bloklab qo'yishlari mumkin
    if user_id in ADMINS:
        return True

    if use_cache:
        cached = cache_get(user_id)
        if cached is not None:
            return cached

    channels = await get_channels()
    if not channels:
        result = True
    else:
        results = await asyncio.gather(*[check_one_channel(context, cid, user_id) for cid, _ in channels])
        result = all(results)

    cache_set(user_id, result)
    return result


