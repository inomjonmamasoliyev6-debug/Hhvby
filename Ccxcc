async def handle_admin_text_state(update: Update, context: ContextTypes.DEFAULT_TYPE, user_id, text) -> bool:
    """Admin 'kanal qo'shish' yoki 'narx o'zgartirish' holatida matn yuborganda ishlaydi.
    Agar biror holat qayta ishlangan bo'lsa True qaytaradi."""
    state = context.user_data.get("state")
    if state not in ("add_channel", "set_price", "broadcast"):
        return False

    if text == CANCEL_TEXT:
        context.user_data["state"] = None
        await api_call(lambda: update.message.reply_text(
            "🚫 Bekor qilindi.", reply_markup=main_keyboard(user_id),
        ), action_desc="admin_text_cancel")
        return True

    if state == "add_channel":
        context.user_data["state"] = None
        parts = text.strip().split(maxsplit=1)
        channel_id = parts[0]
        given_name = parts[1] if len(parts) > 1 else None

        checking = await api_call(lambda: update.message.reply_text("🔄 Tekshirilmoqda..."), action_desc="add_channel_checking")
        title = given_name
        warn = ""
        chat = await api_call(lambda: context.bot.get_chat(channel_id), action_desc="get_chat", swallow=True, default=None)
        if chat:
            if not title:
                title = chat.title or chat.username or channel_id
            bot_member = await api_call(
                lambda: context.bot.get_chat_member(channel_id, context.bot.id),
                action_desc="get_bot_member", swallow=True, default=None,
            )
            if bot_member is None:
                warn = "\n\n⚠️ *Diqqat:* bot a'zoligini tekshirib bo'lmadi — botni admin qilib qo'shganingizga ishonch hosil qiling."
            elif bot_member.status not in ("administrator", "creator"):
                warn = "\n\n⚠️ *Diqqat:* bot bu yerda admin emas — obunani to'liq tekshira olmasligi mumkin."
        else:
            title = title or channel_id
            warn = "\n\n⚠️ *Diqqat:* bot bu kanal/guruhga umuman a'zo emasga o'xshaydi. Avval botni o'sha yerga admin qilib qo'shing."

        await add_channel_db(channel_id, title)
        _sub_cache.clear()

        if checking:
            await api_call(lambda: checking.edit_text(
                f"✅ *Qo'shildi:* {title}\n🆔 `{channel_id}`{warn}",
                parse_mode="Markdown",
            ), action_desc="add_channel_done")
        await api_call(lambda: update.message.reply_text(
            "Bo'lim tanlang:", reply_markup=main_keyboard(user_id),
        ), action_desc="add_channel_menu")
        return True

    if state == "set_price":
        context.user_data["state"] = None
        try:
            price = float(text.strip())
        except ValueError:
            await api_call(lambda: update.message.reply_text(
                "❌ Bu raqam emas. Masalan: `1500`",
                parse_mode="Markdown",
                reply_markup=main_keyboard(user_id),
            ), action_desc="set_price_invalid")
            return True
        await set_ref_price(price)
        await api_call(lambda: update.message.reply_text(
            f"✅ Referal narxi *{price:,.0f} so'm* qilib o'zgartirildi!",
            parse_mode="Markdown",
            reply_markup=main_keyboard(user_id),
        ), action_desc="set_price_done")
        return True

    if state == "broadcast":
        context.user_data["state"] = None
        user_ids = await get_all_user_ids()
        total = len(user_ids)
        progress_msg = await api_call(lambda: update.message.reply_text(f"📤 Yuborilmoqda: 0/{total}"), action_desc="broadcast_start")
        sent = 0
        step = max(1, total // 10)
        for i, uid in enumerate(user_ids, start=1):
            result = await api_call(
                lambda u=uid: context.bot.send_message(chat_id=u, text=text),
                action_desc=f"broadcast:{uid}", swallow=True, default=None,
            )
            if result is not None:
                sent += 1
            if progress_msg and (i % step == 0 or i == total):
                await api_call(lambda i=i: progress_msg.edit_text(f"📤 Yuborilmoqda: {i}/{total}"), action_desc="broadcast_progress")
        if progress_msg:
            await api_call(lambda: progress_msg.edit_text(
                f"✅ *Yakunlandi!* {sent}/{total} ta foydalanuvchiga yuborildi.", parse_mode="Markdown",
            ), action_desc="broadcast_done")
        await api_call(lambda: update.message.reply_text(
            "Bo'lim tanlang:", reply_markup=main_keyboard(user_id),
        ), action_desc="broadcast_menu")
        return True

    return False


async def handle_buttons(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        if not update.message or not update.message.text:
            return
        text = update.message.text
        user_id = update.effective_user.id
        is_admin = user_id in ADMINS

        # Kutilayotgan holatlar (karta raqami, rad etish sababi, admin holatlari) - eng birinchi shu ishlanadi
        if await handle_withdraw_state(update, context, user_id, text):
            return
        if is_admin and await handle_withdraw_reject_reason_state(update, context, user_id, text):
            return
        if is_admin and await handle_admin_text_state(update, context, user_id, text):
            return

        if not await is_subscribed(user_id, context):
            await show_subscription_gate(update, context)
            return

        if text == "💰 Pul ishlash":
            await handle_earn(update, context, user_id)

        elif text == "💸 Pul yechish":
            await handle_withdraw_start(update, context, user_id)

        elif text == "👤 Balans":
            await handle_balance(update, user_id)

        elif text == "📊 Statistika" and is_admin:
            await handle_stats(update)

        elif text == "📢 Xabar yuborish" and is_admin:
            context.user_data["state"] = "broadcast"
            await api_call(lambda: update.message.reply_text(
                "✍️ *Barcha foydalanuvchilarga yubormoqchi bo'lgan xabaringizni yozing:*",
                parse_mode="Markdown",
                reply_markup=cancel_keyboard(),
            ), action_desc="broadcast_prompt")

        elif text == "⚙️ Admin Panel" and is_admin:
            await open_admin_panel(update.message)

        else:
            await api_call(lambda: update.message.reply_text(
                "🤔 Buni tushunmadim. Pastdagi tugmalardan birini tanlang 👇",
                reply_markup=main_keyboard(user_id),
            ), action_desc="unknown_text")
    except Exception:
        logger.exception("handle_buttons() ichida kutilmagan xato")


