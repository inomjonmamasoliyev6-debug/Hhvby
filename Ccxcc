async def animate(message, frames, delay=0.45, parse_mode="Markdown", reply_markup=None):
    """Bitta xabarni ketma-ket tahrirlab, sodda animatsiya effekti beradi."""
    last = len(frames) - 1
    for i, frame in enumerate(frames):
        await api_call(
            lambda f=frame, i=i: message.edit_text(
                f, parse_mode=parse_mode, reply_markup=reply_markup if i == last else None,
            ),
            action_desc="animate",
        )
        if i != last:
            await asyncio.sleep(delay)


