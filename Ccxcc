#  12) GLOBAL XATO TUTUVCHI
# ========================================================

async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    err = context.error

    if isinstance(err, (TimedOut, NetworkError)):
        # Tarmoq bilan bog'liq vaqtinchalik xato - bot ishlashda davom etadi
        logger.warning("Tarmoq bilan bog'liq xato (bot davom etmoqda): %s", err)
        return

    logger.error("Kutilmagan xato: %s", err, exc_info=err)

    # Adminga qisqacha xabar berishga urinamiz (muvaffaqiyatsiz bo'lsa ham botni cho'ktirmaymiz)
    try:
        if ADMINS:
            await api_call(
                lambda: context.bot.send_message(
                    chat_id=ADMINS[0],
                    text=f"⚠️ Botda xato yuz berdi:\n`{str(err)[:500]}`",
                    parse_mode="Markdown",
                ),
                retries=2,
                action_desc="error_notify_admin",
            )
    except Exception:
        logger.exception("error_handler admin xabarini yuborishda ham xato chiqdi")


# ========================================================
#  13) ISHGA TUSHIRISH
# ========================================================

def main():
    if TOKEN == "BU_YERGA_YANGI_TOKENINGIZNI_YOZING":
        print("❌ Avval yuqoridagi TOKEN qatoriga @BotFather'dan olgan tokeningizni yozing!")
        return

    asyncio.run(init_db())

    # Oddiy so'rovlar uchun (send_message, get_chat va h.k.) - uzaytirilgan timeoutlar
    request = HTTPXRequest(
        connect_timeout=30.0,
        read_timeout=30.0,
        write_timeout=30.0,
        pool_timeout=30.0,
    )
    # get_updates (long-polling) uchun - biroz uzunroq read_timeout kerak,
    # chunki Telegram serveri javobni kutib turadi
    get_updates_request = HTTPXRequest(
        connect_timeout=30.0,
        read_timeout=40.0,
        write_timeout=30.0,
        pool_timeout=30.0,
    )

    app = (
        ApplicationBuilder()
        .token(TOKEN)
        .request(request)
        .get_updates_request(get_updates_request)
        .build()
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(check_sub_callback, pattern="^check_sub$"))
    app.add_handler(CallbackQueryHandler(refresh_ref_callback, pattern="^refresh_ref$"))
    app.add_handler(CallbackQueryHandler(withdraw_type_callback, pattern="^(wd_type:|wd_cancel$)"))
    app.add_handler(CallbackQueryHandler(withdraw_admin_decision_callback, pattern="^(wdok:|wdno:)"))
    app.add_handler(CallbackQueryHandler(admin_panel_callback, pattern="^(admin_|rmch:)"))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_buttons))
    app.add_error_handler(error_handler)

    print("🚀 Pro bot ishga tushdi!")
    app.run_polling(
        drop_pending_updates=True,
        allowed_updates=["message", "callback_query"],
    )


if __name__ == '__main__':
    main()
