async def admin_panel_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        query = update.callback_query
        user_id = query.from_user.id
        if user_id not in ADMINS:
            await api_call(lambda: query.answer("⛔ Ruxsat yo'q", show_alert=True), action_desc="admin_denied")
            return

        data = query.data
        await api_call(lambda: query.answer(), action_desc="admin_ack")

        if data == "admin_close":
            await api_call(lambda: query.message.delete(), action_desc="admin_close")
            return

        if data == "admin_back":
            await open_admin_panel(query, edit=True)
            return

        if data == "admin_add_channel":
            context.user_data["state"] = "add_channel"
            await api_call(lambda: query.message.edit_text(
                "➕ *Kanal/Guruh qo'shish*\n"
                f"{DIVIDER}\n"
                "Quyidagi ko'rinishda yuboring:\n"
                "`@kanal_username Nomi`\n\n"
                "Yoki faqat ID/username yuborsangiz ham bo'ladi, nomi avtomatik olinadi.\n\n"
