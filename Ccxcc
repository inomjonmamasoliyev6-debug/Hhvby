# ==================== YORDAMCHI FUNKSIYALAR ====================
def is_banned(user_id):
    return user_id in banned_users and user_id != ADMIN_ID


def check_cooldown(user_id):
    """True qaytarsa - band, kutish kerak."""
    now = time.time()
    last = last_request_time.get(user_id, 0)
    if now - last < COOLDOWN_SECONDS:
        return True
    last_request_time[user_id] = now
    return False


def has_limit(user_id):
    if user_id == ADMIN_ID:
        return True
    max_allowed = custom_limits.get(user_id, FREE_LIMIT)
    used = user_limits.get(user_id, 0)
    return used < max_allowed


def download_image(url, timeout=20):
    """Rasmni avval serverga yuklab olamiz, shunda Telegram xatolik bermaydi."""
    resp = requests.get(url, timeout=timeout)
    resp.raise_for_status()
    if len(resp.content) < 500:  # juda kichik javob = xato
        raise ValueError("bo'sh yoki noto'g'ri rasm javobi")
    bio = BytesIO(resp.content)
    bio.name = "logo.png"
    return bio


def generate_and_send_logos(chat_id, user_id, name, style, width, height):
    """Bir nechta logo variantini yuklab, muvaffaqiyatli bo'lganlarini yuboradi."""
    global total_logos_generated

    base_template = STYLE_PROMPTS.get(style, STYLE_PROMPTS["minimalist"])
    sent_count = 0

    for i in range(IMAGES_PER_REQUEST):
        hint = VARIANT_HINTS[i % len(VARIANT_HINTS)]
        prompt = f"{base_template.format(name=name)}, {hint}, sharp details, highly detailed graphic design."
        safe_prompt = urllib.parse.quote(prompt)
        seed = random.randint(10000, 999999)
        url = f"https://image.pollinations.ai/prompt/{safe_prompt}?width={width}&height={height}&nologo=true&seed={seed}"

        # har bir rasmga 2 marta urinib ko'ramiz (birinchi urinish muvaffaqiyatsiz bo'lsa)
        photo_bytes = None
        for attempt in range(2):
            try:
                photo_bytes = download_image(url)
                break
            except Exception:
                time.sleep(1.5)
                continue

        if photo_bytes is None:
            continue

        try:
            bot.send_photo(chat_id, photo_bytes)
            sent_count += 1
            total_logos_generated += 1
        except Exception:
            continue

    return sent_count


