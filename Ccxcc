@bot.message_handler(func=lambda message: True)
def handle_text(message):
    user_id = message.from_user.id
    text = message.text.strip()

    if is_banned(user_id):
        bot.send_message(message.chat.id, "🚫 Siz botdan foydalanishdan bloklangansiz.")
        return

    # ---- Admin holatlari ----
    if user_id == ADMIN_ID and user_id in admin_states:
        state = admin_states.pop(user_id)
        if state == "broadcast":
            count = 0
            for uid in users_list:
                try:
                    bot.send_message(uid, text)
                    count += 1
                except Exception:
                    pass
            bot.send_message(message.chat.id, f"✅ Xabar <b>{count}</b> ta foydalanuvchiga yuborildi!", parse_mode="HTML")
            return
        elif state == "add_vip":
            try:
                target_id = int(text)
                custom_limits[target_id] = 1000
                bot.send_message(message.chat.id, f"🎉 Foydalanuvchi <code>{target_id}</code> ga VIP berildi!", parse_mode="HTML")
            except ValueError:
                bot.send_message(message.chat.id, "❌ Noto'g'ri ID.")
            return
        elif state == "change_limit":
            global FREE_LIMIT
            try:
                FREE_LIMIT = int(text)
                bot.send_message(message.chat.id, f"✅ Yangi standart limit: <b>{FREE_LIMIT}</b>", parse_mode="HTML")
            except ValueError:
                bot.send_message(message.chat.id, "❌ Noto'g'ri son.")
            return
        elif state == "add_promo":
            parts = text.split()
            if len(parts) == 2 and parts[1].isdigit():
                code, val = parts[0].upper(), int(parts[1])
                promo_codes[code] = val
                bot.send_message(message.chat.id, f"✅ <code>{code}</code> promo-kodi qo'shildi (+{val} limit).", parse_mode="HTML")
            else:
                bot.send_message(message.chat.id, "❌ Format xato! Masalan: <code>NEW2026 5</code>", parse_mode="HTML")
            return
        elif state == "ban_user":
            try:
                target_id = int(text)
                if target_id in banned_users:
                    banned_users.discard(target_id)
                    bot.send_message(message.chat.id, f"✅ <code>{target_id}</code> blokdan chiqarildi.", parse_mode="HTML")
                else:
                    banned_users.add(target_id)
                    bot.send_message(message.chat.id, f"🚫 <code>{target_id}</code> bloklandi.", parse_mode="HTML")
            except ValueError:
                bot.send_message(message.chat.id, "❌ Noto'g'ri ID.")
            return

    # ---- Foydalanuvchi kutilayotgan holatlari (promo-kod) ----
    if user_id in user_states and user_states[user_id] == "awaiting_promo":
        user_states.pop(user_id, None)
        code = text.upper()
        already_used = used_promo_by_user.get(user_id, set())

        if code in already_used:
            bot.send_message(message.chat.id, "⚠️ Siz bu promo-koddan avval foydalangansiz.", reply_markup=get_main_reply_keyboard())
        elif code in promo_codes:
            bonus = promo_codes[code]
            current_max = custom_limits.get(user_id, FREE_LIMIT)
            custom_limits[user_id] = current_max + bonus
            used_promo_by_user.setdefault(user_id, set()).add(code)
            bot.send_message(message.chat.id, f"🎉 Tabriklaymiz! Sizga <b>+{bonus}</b> ta qo'shimcha limit berildi!", parse_mode="HTML", reply_markup=get_main_reply_keyboard())
